<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EricksonLopez.Resilience.AotSmokeTest</RootNamespace>
    <AssemblyName>EricksonLopez.Resilience.AotSmokeTest</AssemblyName>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EricksonLopez.Resilience.Abstractions\EricksonLopez.Resilience.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Resilience\EricksonLopez.Resilience.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Resilience.Polly\EricksonLopez.Resilience.Polly.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Resilience.DependencyInjection\EricksonLopez.Resilience.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Resilience.Mediator\EricksonLopez.Resilience.Mediator.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Resilience.OpenTelemetry\EricksonLopez.Resilience.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\EricksonLopez.Resilience.AspNetCore\EricksonLopez.Resilience.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

</Project>
