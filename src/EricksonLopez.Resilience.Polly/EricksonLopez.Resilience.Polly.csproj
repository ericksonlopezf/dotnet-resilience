<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Polly v8 infrastructure adapter for EricksonLopez.Resilience, encapsulating ResiliencePipeline execution behind ecosystem abstractions.</Description>
    <PackageTags>$(CommonPackageTags);polly;polly-v8;adapter;infrastructure;execution-engine</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.Resilience.Abstractions\EricksonLopez.Resilience.Abstractions.csproj" />
    <ProjectReference Include="..\EricksonLopez.Resilience\EricksonLopez.Resilience.csproj" />
    <ProjectReference Include="..\EricksonLopez.Resilience.OpenTelemetry\EricksonLopez.Resilience.OpenTelemetry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.RateLimiting" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.Resilience.Polly.Tests" />
  </ItemGroup>

</Project>
